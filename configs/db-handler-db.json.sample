{
  "connections": [
    {
      "database": "demo",
      "driver": "sqlite",
      "name": "var/demo.db?_pragma=foreign_keys(1)"
    },
    {
      "database": "shop",
      "instance": "au",
      "default": true,
      "driver": "postgres",
      "host": "localhost",
      "port": 5432,
      "user": "shop",
      "password": "change-me",
      "name": "shop",
      "params": {
        "sslmode": "disable"
      },
      "maxOpenConns": 20,
      "maxIdleConns": 5,
      "connMaxLifetime": "30m",
      "slowQuery": "500ms"
    },
    {
      "database": "shop",
      "instance": "nz",
      "driver": "postgres",
      "host": "localhost",
      "port": 5433,
      "user": "shop",
